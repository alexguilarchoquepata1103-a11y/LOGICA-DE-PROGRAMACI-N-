#include <iostream>
#include <string>
using namespace std;

int main()
{
    string nombre1, nombre2;
    long long A, B;  // uso long por si el puntaje es hasta 2^31
    
    cin >> nombre1 >> A;
    cin >> nombre2 >> B;
    
    if (A > B)
        cout << nombre1;
    else
        cout << nombre2;
    
    return 0;
}