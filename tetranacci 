#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Cuantos terminos: ";
    cin >> n;

    long long a = 0, b = 0, c = 0, d = 1; 

    if (n >= 1) cout << a << " ";
    if (n >= 2) cout << b << " ";
    if (n >= 3) cout << c << " ";
    if (n >= 4) cout << d << " ";

    for (int i = 4; i < n; i++) {
        long long next = a + b + c + d;
        cout << next << " ";
        a = b;
        b = c;
        c = d;
        d = next;
    }
    return 0;
}