#include <iostream>
using namespace std;

int main()
{
    bool A, B;
    
    cout << "Ingresa A y B 0 o 1: ";
    cin >> A >> B;
    
    // Simulando AND con if
    if (A == 1 && B == 1)  // esto es el AND
    {
        cout << "Resultado AND: 1" << endl;
    }
    else
    {
        cout << "Resultado AND: 0" << endl;
    }
    
    // Tabla de verdad completa
    cout << "\nTabla de verdad AND:" << endl;
    cout << "0 AND 0 = " << (0 && 0) << endl;
    cout << "0 AND 1 = " << (0 && 1) << endl;
    cout << "1 AND 0 = " << (1 && 0) << endl;
    cout << "1 AND 1 = " << (1 && 1) << endl;
    
    return 0;
}